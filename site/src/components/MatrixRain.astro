<canvas data-matrix aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full opacity-25"></canvas>
<script is:inline>
  const cv = document.querySelector('[data-matrix]');
  const ctx = cv && cv.getContext('2d');
  if (!cv || !ctx) return;

  const FONT = 13;
  const GLYPHS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ0123456789';
  const HEAD = ['#bd93f9', '#f8f8f2'];
  const TRAIL = 'rgba(130,140,190,0.45)';
  const FADE = 'rgba(24,26,37,0.10)';
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let w = 0;
  let h = 0;
  let cols = [];

  const glyph = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

  const size = () => {
    const r = cv.parentElement.getBoundingClientRect();
    w = cv.width = Math.max(1, r.width | 0);
    h = cv.height = Math.max(1, r.height | 0);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, w, h);
    const n = Math.ceil(w / FONT);
    cols = Array.from({ length: n }, () => ({
      y: -FONT * (2 + Math.random() * 8),
      speed: 0.7 + Math.random() * 1.1,
    }));
  };

  const step = () => {
    ctx.fillStyle = FADE;
    ctx.fillRect(0, 0, w, h);
    ctx.font = FONT + 'px ui-monospace, monospace';
    for (let i = 0; i < cols.length; i++) {
      const c = cols[i];
      for (let t = 1; t <= 6; t++) {
        const y = c.y - t * FONT;
        if (y < -FONT) break;
        ctx.fillStyle = TRAIL;
        ctx.fillText(glyph(), i * FONT, y);
      }
      ctx.fillStyle = HEAD[(Math.random() * HEAD.length) | 0];
      ctx.fillText(glyph(), i * FONT, c.y);
    }
    for (const c of cols) {
      c.y += c.speed * (FONT / 2);
      if (c.y > h + 6 * FONT) c.y = -FONT * 4;
    }
  };

  window.addEventListener('resize', size);
  size();
  if (reduce) {
    step();
  } else {
    const loop = () => {
      step();
      setTimeout(loop, 55);
    };
    loop();
  }
</script>
