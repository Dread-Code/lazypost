---
import { docs } from '../data/docs.js';
const base = import.meta.env.BASE_URL;
const { current } = Astro.props;
---
<aside class="hidden w-52 shrink-0 lg:block">
  <nav class="sticky top-6 space-y-1">
    <p class="mb-2 font-mono text-xs font-bold text-faint">{'// docs'}</p>
    {docs.map((d) => (
      <a
        href={`${base}docs/${d.slug}/`}
        aria-current={d.slug === current ? 'page' : undefined}
        class:list={[
          'block rounded-md px-3 py-1.5 font-mono text-xs transition-colors',
          d.slug === current ? 'bg-raised text-accent' : 'text-muted hover:bg-raised hover:text-text',
        ]}
      >
        {d.title}
      </a>
    ))}
  </nav>
</aside>
