---
import { themes } from '../data/themes.js';

const vimKeys = [
  ['h j k l', 'motions'],
  ['w b e', 'words'],
  ['0 $ ^', 'line edges'],
  ['g g G', 'jump'],
  ['dd dw d$', 'delete'],
  ['yy yw y$', 'yank'],
  ['v / V', 'visual'],
  ['p / P', 'paste'],
  ['%', 'match'],
];
---
<section class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="font-mono text-base font-bold text-accent">$ lazypost</h2>
  <p class="mt-3 font-mono text-sm text-faint">a look around</p>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <article class="overflow-hidden rounded-xl border border-line2 bg-panel transition-all duration-200 hover:-translate-y-0.5 hover:border-accent">
      <header class="border-b border-line bg-navbar px-4 py-2.5 font-mono text-xs text-faint">vim editing</header>
      <div class="grid grid-cols-3 gap-2 p-4 font-mono text-xs">
        {vimKeys.map(([keys, action]) => (
          <div class="rounded-md border border-line bg-raised px-2 py-1.5 text-center">
            <div class="text-text">{keys}</div>
            <div class="mt-0.5 text-faint">{action}</div>
          </div>
        ))}
      </div>
    </article>
    <article class="overflow-hidden rounded-xl border border-line2 bg-panel transition-all duration-200 hover:-translate-y-0.5 hover:border-accent">
      <header class="border-b border-line bg-navbar px-4 py-2.5 font-mono text-xs text-faint">lua chaining</header>
      <pre class="overflow-x-auto p-4 font-mono text-xs leading-6 text-text"><span class="text-faint">-- pre</span>
<span class="text-cyan">req</span>.<span class="text-text">headers</span>[<span class="text-gold">"X-Session"</span>] = <span class="text-cyan">store</span>.<span class="text-text">get</span>(<span class="text-gold">"token"</span>)
<span class="text-cyan">req</span>.<span class="text-text">query</span>[<span class="text-gold">"page"</span>] = <span class="text-gold">"2"</span>
<span class="text-faint">-- post</span>
<span class="text-accent">local</span> id = <span class="text-cyan">string</span>.<span class="text-text">match</span>(response.body, <span class="text-gold">'"id": (%d+)'</span>)
<span class="text-cyan">store</span>.<span class="text-text">set</span>(<span class="text-gold">"last_id"</span>, id)</pre>
    </article>
    <article class="overflow-hidden rounded-xl border border-line2 bg-panel transition-all duration-200 hover:-translate-y-0.5 hover:border-accent">
      <header class="border-b border-line bg-navbar px-4 py-2.5 font-mono text-xs text-faint">curl import</header>
      <div class="p-4 font-mono text-xs leading-6">
        <div><span class="text-accent">$</span> <span class="text-text">paste curl …</span></div>
        <div class="mt-1 text-faint">any pane accepts a pasted curl command</div>
        <div class="mt-4"><span class="text-accent">ctrl+g</span> <span class="text-text">export the current request as curl</span></div>
      </div>
    </article>
    <article class="overflow-hidden rounded-xl border border-line2 bg-panel transition-all duration-200 hover:-translate-y-0.5 hover:border-accent">
      <header class="border-b border-line bg-navbar px-4 py-2.5 font-mono text-xs text-faint">importers</header>
      <div class="p-4 font-mono text-xs leading-6">
        <div><span class="text-accent">$</span> <span class="text-text">lazypost import postman-collection.json</span></div>
        <div class="mt-1 text-faint">postman v2.1 · workspaces become folders</div>
        <div class="mt-4"><span class="text-accent">$</span> <span class="text-text">lazypost import insomnia-export.yaml</span></div>
        <div class="mt-1 text-faint">insomnia v4 / v5 · environments preserved</div>
        <div class="mt-4 text-faint">--dry-run previews · --strict enforcement</div>
      </div>
    </article>
    <article class="overflow-hidden rounded-xl border border-line2 bg-panel transition-all duration-200 hover:-translate-y-0.5 hover:border-accent">
      <header class="border-b border-line bg-navbar px-4 py-2.5 font-mono text-xs text-faint">themes</header>
      <ul class="flex flex-wrap gap-2 p-4">
        {themes.map((t) => (
          <li>
            <button
              type="button"
              data-theme={t.name}
              data-bg={t.bg}
              data-panel={t.panel}
              data-raised={t.raised}
              data-line={t.line}
              data-line2={t.line2}
              data-navbar={t.navbar}
              data-text={t.text}
              data-muted={t.muted}
              data-faint={t.faint}
              data-accent={t.accent}
              data-gold={t.gold}
              data-cyan={t.cyan}
              aria-pressed="false"
              class="flex cursor-pointer items-center gap-2 rounded-full border border-line bg-raised px-3 py-1.5 font-mono text-xs text-muted transition-colors hover:border-accent"
            >
              <span class="h-3 w-3 rounded-full" style={`background:${t.accent}`}></span>
              <span>{t.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
<script is:inline>
  (() => {
    const KEY = 'lazypost-theme';
    const TOKENS = ['bg', 'panel', 'raised', 'line', 'line2', 'navbar', 'text', 'muted', 'faint', 'accent', 'gold', 'cyan'];
    const buttons = [...document.querySelectorAll('[data-theme]')];
    if (!buttons.length) return;
    const apply = (name) => {
      const btn = buttons.find((b) => b.dataset.theme === name) || buttons[0];
      const root = document.documentElement.style;
      for (const key of TOKENS) {
        root.setProperty(`--color-${key}`, btn.dataset[key]);
      }
      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('border-accent', on);
        b.classList.toggle('text-text', on);
        b.classList.toggle('border-line', !on);
        b.classList.toggle('text-muted', !on);
      });
    };
    let saved = 'dracula';
    try {
      saved = localStorage.getItem(KEY) || 'dracula';
    } catch (e) {}
    apply(saved);
    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        try {
          localStorage.setItem(KEY, b.dataset.theme);
        } catch (e) {}
        apply(b.dataset.theme);
      });
    });
  })();
</script>
