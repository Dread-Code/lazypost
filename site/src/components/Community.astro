---
import { github } from '../data/site.js';
---
<section class="mx-auto max-w-6xl px-6 py-24 text-center">
  <p class="mx-auto max-w-xl text-lg leading-relaxed text-muted">
    Open source, MIT licensed. Built by developers, for developers. Contributions, themes and feedback are always welcome.
  </p>
  <a href={github} target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-mono text-sm font-bold text-bg transition-opacity hover:opacity-85">
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-gold" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
    star on github
  </a>
</section>
